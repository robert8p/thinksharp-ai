{
  "expo": {
    "name": "Humanity",
    "slug": "humanity",
    "scheme": "humanity",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F7FFF4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.humanity.thinking"
    },
    "android": {
      "package": "com.humanity.thinking",
      "adaptiveIcon": {
        "backgroundColor": "#F7FFF4"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
